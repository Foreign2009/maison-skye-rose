# ─────────────────────────────────────────────────────────────────────────────
# Maison Skye & Rose — Environment Variables
#
# Copy this file to .env.local for local development.
# Set every variable marked [REQUIRED] in your Vercel project settings
# before deploying to production.
#
# Variables prefixed NEXT_PUBLIC_ are included in the browser JS bundle.
# Do not place secrets in NEXT_PUBLIC_ variables unless noted as intentional.
# ─────────────────────────────────────────────────────────────────────────────


# ── SITE ─────────────────────────────────────────────────────────────────────
#
# The canonical production URL, without a trailing slash.
# Used by: robots.ts, sitemap.ts, app/layout.tsx (metadataBase, OG images).
#
# CRITICAL: If this is not set to the production domain on Vercel,
# all canonical URLs, OG image URLs, and the sitemap will resolve to
# the fallback (http://localhost:3000), corrupting SEO on the first deploy.
#
# [REQUIRED — Vercel]
NEXT_PUBLIC_WEBSITE_URL=https://www.yourdomain.co.za


# ── SUPABASE ──────────────────────────────────────────────────────────────────
#
# Project credentials from: Supabase Dashboard → Project Settings → API.
# The anon key is intentionally public — it is safe for client-side use
# when Supabase Row Level Security (RLS) is correctly configured.
#
# [REQUIRED — Vercel]
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# [REQUIRED — Vercel]
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service role key — bypasses RLS. Server-only: never use in client code.
# From: Supabase Dashboard → Project Settings → API → service_role key.
# Required by the order management endpoint (PATCH /api/orders/[ref]).
#
# [REQUIRED — Vercel]
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key


# ── PAYFAST ───────────────────────────────────────────────────────────────────
#
# Credentials from: PayFast Dashboard → Settings → Merchant Details.
#
# SECURITY NOTE: These variables currently use the NEXT_PUBLIC_ prefix,
# which exposes them to the browser JS bundle. This is a known issue
# scheduled for remediation in EP8-P3 (PayFast hardening sprint), which
# will move these to server-only variables and update the API route.
# Do not promote these to server-only variables without updating
# app/api/payfast/route.ts at the same time.
#
# For production, set PAYFAST_ENV=production to switch from the sandbox
# to the live PayFast endpoint (also handled in EP8-P3).
#
# [REQUIRED — Vercel]
NEXT_PUBLIC_PAYFAST_MERCHANT_ID=your-payfast-merchant-id

# [REQUIRED — Vercel]
NEXT_PUBLIC_PAYFAST_MERCHANT_KEY=your-payfast-merchant-key

# [REQUIRED — Vercel] Must not be empty. Set in PayFast Dashboard → Settings → Passphrase.
NEXT_PUBLIC_PAYFAST_PASSPHRASE=your-payfast-passphrase


# ── ANTHROPIC (MAISON CONCIERGE) ──────────────────────────────────────────────
#
# API key from: console.anthropic.com → API Keys.
# Used exclusively server-side by app/api/concierge/route.ts.
# This variable does NOT use the NEXT_PUBLIC_ prefix — it is never
# exposed to the browser.
#
# [REQUIRED — Vercel] Concierge is silently broken without this.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional: override the default Concierge model (default: claude-sonnet-5).
# CLAUDE_CONCIERGE_MODEL=claude-sonnet-5


# ── ORDER MANAGEMENT ─────────────────────────────────────────────────────────
#
# Secret used to authenticate PATCH /api/orders/[ref] (order status updates).
# Generate a strong random value, e.g.: openssl rand -base64 32
# Keep this out of version control and never expose it client-side.
# If unset, the endpoint returns 503 for all requests.
#
# [REQUIRED — Vercel]
ADMIN_SECRET=your-strong-random-admin-secret


# ── ANALYTICS (POSTHOG) ───────────────────────────────────────────────────────
#
# Credentials from: PostHog Dashboard → Project Settings → Project API Key.
# Analytics silently fails if these are not set (safeCall wrapper isolates
# failures), but zero customer behaviour data will be captured.
#
# [REQUIRED — Vercel] Without this, no analytics events are recorded.
NEXT_PUBLIC_POSTHOG_KEY=phc_your-posthog-project-key

# [REQUIRED — Vercel] Typically https://app.posthog.com (US cloud)
# or https://eu.posthog.com (EU cloud). Check your PostHog project region.
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
